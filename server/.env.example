# Copie ce fichier en .env (dans le dossier server/) et remplis les valeurs. Ne le partage jamais.
# Clé d'authentification Tailscale (admin Tailscale → Settings → Keys → Generate auth key, « Reusable » décoché suffit)
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# Sites autorisés à appeler le serveur (l'adresse de l'app, séparées par des virgules)
ALLOWED_ORIGINS=https://nathfun.github.io
FIREBASE_PROJECT_ID=jeux-de-cartes-81cdf
FIREBASE_DATABASE_URL=https://jeux-de-cartes-81cdf-default-rtdb.europe-west1.firebasedatabase.app
