{
  "rules": {
    "tables": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/)"
      }
    },
    "chats": {
      "$code": {
        ".read": "auth != null",
        "$msg": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
          ".validate": "newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 300"
        },
        ".write": "auth != null && !newData.exists()"
      }
    },
    "presence": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "ptables": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/)"
      }
    },
    "pchats": {
      "$code": {
        ".read": "auth != null",
        "$msg": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
          ".validate": "newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 300"
        },
        ".write": "auth != null && !newData.exists()"
      }
    },
    "ppresence": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "phands": {
      "$code": {
        ".write": "auth != null && !newData.exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || root.child('ptables').child($code).child('host').val() === auth.uid)"
        }
      }
    },
    "pdeck": {
      "$code": {
        ".read": "auth != null && root.child('ptables').child($code).child('host').val() === auth.uid",
        ".write": "auth != null && (root.child('ptables').child($code).child('host').val() === auth.uid || !newData.exists())"
      }
    },
    "rtables": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/)"
      }
    },
    "rchats": {
      "$code": {
        ".read": "auth != null",
        "$msg": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
          ".validate": "newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 300"
        },
        ".write": "auth != null && !newData.exists()"
      }
    },
    "rpresence": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['data', 'at']) && newData.child('data').isString() && newData.child('data').val().length < 200000"
      }
    },
    "vault": {
      "$uid": { ".read": false, ".write": false }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "friendcodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.val() === auth.uid && $code.matches(/^[A-Z0-9]{6}$/)"
      }
    },
    "challenges": {
      "$code": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && !data.exists()"
        },
        "results": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}